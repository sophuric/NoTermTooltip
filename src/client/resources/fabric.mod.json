{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Hides item tooltips in F7 terminals",
  "authors": [
    "sophur"
  ],
  "contact": {
    "sources": "https://github.com/${repo_github}"
  },
  "license": "MPL-2.0",
  "icon": "assets/notermtooltip/icon.png",
  "environment": "client",
  "accessWidener": "notermtooltip.classtweaker",
  "entrypoints": {
    "client": [
      "me.sophur.notermtooltip.NoTermTooltipClient"
    ]
  },
  "mixins": [
    "notermtooltip.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "hypixel-mod-api": ">=${hypixel_mod_api_version}"
  }
}
